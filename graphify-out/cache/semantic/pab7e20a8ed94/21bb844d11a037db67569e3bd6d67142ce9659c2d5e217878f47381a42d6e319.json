", "source_location": "L115", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regex + NER scan flags documents; nothing is chunked or embedded until an admin clears to acknowledged_safe, preventing PII leakage via chatbot."}, {"id": "_plans_02_ai_features_spec_strict_grounding", "label": "Strict Grounding Guardrail", "file_type": "rationale", "source_file": ".plans/02-AI-Features-Spec.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_plans_02_ai_features_spec_ai_cost_management", "label": "AI Cost Management", "file_type": "concept", "source_file": ".plans/02-AI-Features-Spec.md", "source_location": "L172", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unbounded chatbot use by one resident could exceed $500/month, so rate limits and budget caps are mandatory."}, {"id": "_plans_02_ai_features_spec_per_resident_chatbot_rate_limit", "label": "Per-resident Chatbot Rate Limit (20/day)", "file_type": "concept", "source_file": ".plans/02-AI-Features-Spec.md", "source_location": "L176", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_plans_02_ai_features_spec_monthly_ai_budget_cap", "label": "Monthly HOA AI Budget Cap (80% alert, 100% gate)", "file_type": "concept", "source_file": ".plans/02-AI-Features-Spec.md", "source_location": "L178", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_plans_02_ai_features_spec_model_provider_options", "label": "LLM Model Provider Options (Claude / GPT-4 / open-source)", "file_type": "concept", "source_file": ".plans/02-AI-Features-Spec.md", "source_location": "L187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Start with a commercial API to ship fast, evaluate cost, consider self-hosting if usage scales."}], "edges": [{"source": "_plans_02_ai_features_spec