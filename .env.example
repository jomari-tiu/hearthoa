# Postgres connection. Local: `docker run --name hearthhoa-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d ankane/pgvector`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hearthhoa?schema=public"

# JWT signing secret. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"

# Public API base URL (relative for same-origin).
NEXT_PUBLIC_API_URL="/api"
